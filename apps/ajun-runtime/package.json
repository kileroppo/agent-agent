{
  "name": "ajun-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Army local capability gateway, execution adapter, diagnostics, and recovery runtime",
  "type": "module",
  "exports": {
    "./task-run-event-store": "./src/task-run-event-store.js"
  },
  "scripts": {
    "dev": "AJUN_HOST=127.0.0.1 AJUN_DEV_HOT_RELOAD=true AJUN_DISABLE_BACKGROUND_SERVICES=true PORT=${PORT:-4322} node --watch-preserve-output --watch-path=src --watch-path=public --watch-path=../../agents --watch-path=../../integrations --watch-path=../../packages src/server.js",
    "start": "node src/server.js",
    "acceptance:governance-feishu": "NODE_NO_WARNINGS=1 node scripts/verify-governance-feishu-acceptance.mjs",
    "acceptance:m3-content-growth": "node scripts/verify-m3-content-growth.mjs",
    "acceptance:m3-hermes-content-growth": "node scripts/verify-m3-content-growth.mjs --with-hermes",
    "acceptance:m3-paperclip-heartbeat": "node scripts/verify-m3-paperclip-heartbeat.mjs",
    "acceptance:m4-role-quality": "node scripts/verify-m4-role-quality.mjs",
    "verify:office-presentation": "node scripts/verify-office-presentation.mjs",
    "verify:video-analysis-local-fallback": "NODE_NO_WARNINGS=1 node scripts/verify-video-analysis-local-fallback.mjs",
    "test:video-analysis-local-fallback": "NODE_NO_WARNINGS=1 node --test test/video-analysis-local-fallback.test.js",
    "release:immutable": "node scripts/manage-immutable-runtime-release.mjs",
    "check:typescript-ratio": "node scripts/check-typescript-ratio.mjs",
    "check": "tsc -p tsconfig.json && npm run check:typescript-ratio",
    "pretest": "npm run check",
    "test": "node --test"
  },
  "dependencies": {
    "@agent-army/m5-contracts": "0.1.0",
    "@agent-army/m5-kernel": "0.1.0",
    "@agent-army/m5-content-pipeline": "0.1.0",
    "@agent-army/m5-publisher-gateway": "0.1.0",
    "@agent-army/paperclip-client": "0.1.0",
    "@agent-army/paperclip-content-autonomy": "0.5.0",
    "@agent-army/boom-monitor": "0.1.0",
    "@larksuite/channel": "^0.4.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajun-common-access": "0.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
