# Server and local work directory
PORT=4318
WORK_DIR=./data

# Feishu/Hermes inbound media is accepted only from this local cache root.
# When the service is started with HERMES_HOME, it defaults to $HERMES_HOME/cache.
# INBOUND_MEDIA_ALLOWED_ROOTS=/absolute/path/to/hermes-profile/cache
# INBOUND_MEDIA_MAX_BYTES=1073741824

# ASR: mlx-whisper is the default on Apple Silicon.
ASR_BIN=mlx_whisper
ASR_MODEL=mlx-community/whisper-large-v3-turbo

# Transparent progressive ASR routing. Standard tasks may first use the local
# faster-whisper-small candidate. Low-confidence output, formal/full tasks and
# long media automatically use the quality model above; users never choose a
# model. The fast runtime is isolated outside the repository by the setup script.
ADAPTIVE_ASR_ENABLED=1
# FASTER_WHISPER_PYTHON=~/.local/share/agent-army/xiaod-faster-whisper/bin/python
# FASTER_WHISPER_MODEL_ROOT=~/.cache/huggingface/hub/models--Systran--faster-whisper-small/snapshots
FASTER_WHISPER_MODEL_ID=Systran/faster-whisper-small
FASTER_WHISPER_COMPUTE_TYPE=int8
# This Mac benchmarks MLX large-v3-turbo faster than CTranslate2 small, so the
# progressive path stays off. The small model remains an automatic low-risk
# fallback when MLX fails, and its output always requires human review.
FASTER_WHISPER_PROGRESSIVE_ENABLED=0
FASTER_WHISPER_MIN_DURATION_SECONDS=60
FASTER_WHISPER_MAX_DURATION_SECONDS=1800

# Acceptance testing only: fail exactly one task at the named stage, then leave
# the process running normally. Do not set this outside a controlled local test.
# XIAOD_TEST_FAIL_ONCE_AT=transcribing

# Optional OpenAI-compatible text refiner. Without this, the app performs
# mechanical cleanup only and marks the delivery as needing a human quality pass.
# OpenAI-compatible provider example:
# TEXT_REFINER_URL=http://127.0.0.1:11434/v1/chat/completions
# TEXT_REFINER_API_KEY=
# TEXT_REFINER_MODEL=qwen3:8b
# TEXT_REFINER_MAX_TOKENS=8192

# StepFun Messages API example. For step-3.5/3.7 use this base or the full
# https://api.stepfun.com/v1/messages URL. step-router-v1 uses Step Plan.
# The service resolves the matching /messages path automatically.
# TEXT_REFINER_URL=https://api.stepfun.com/v1
# TEXT_REFINER_API_KEY=
# TEXT_REFINER_MODEL=step-3.7-flash

# Optional Feishu delivery. Keep these in .env, never in a task or document.
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_USER_OPEN_ID=

# Optional local deep-content route. Both endpoints must stay on this Mac's
# loopback interface. CookieBridge is an internal source of a temporary login
# state; it is never exposed through the task API, web UI, logs, or documents.
# MEDIACRAWLER_COOKIE_BRIDGE_URL=http://127.0.0.1:8274
# MEDIACRAWLER_DOWNLOAD_SERVER_URL=http://127.0.0.1:8205
