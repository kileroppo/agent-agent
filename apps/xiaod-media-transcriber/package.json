{
  "name": "media-transcriber-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first audio/video transcription and delivery agent",
  "type": "module",
  "scripts": {
    "build:frontend": "tsc -p frontend/tsconfig.json",
    "dev": "npm run build:frontend && node --watch src/server.ts",
    "start": "npm run build:frontend && node src/server.ts",
    "check": "tsc -p tsconfig.json && npm run build:frontend",
    "pretest": "npm run check",
    "test": "node --test"
  },
  "dependencies": {
    "ajun-common-access": "0.1.0",
    "ajun-runtime": "0.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "typescript": "5.9.3"
  }
}
