{
  "name": "agent-army",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/ajun-runtime",
    "apps/animated-chart",
    "apps/mac-worker",
    "apps/project-progress-board",
    "apps/xiaod-media-transcriber",
    "integrations/access",
    "integrations/boom-monitor",
    "integrations/local-ai",
    "integrations/m5-kernel",
    "integrations/paperclip/m5-content-pipeline",
    "integrations/paperclip/plugins/content-autonomy",
    "integrations/publishing/m5-publisher-gateway",
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present && node --test scripts/*.test.mjs",
    "build:boom-frontend": "tsc -p apps/boom-monitor/frontend/tsconfig.json",
    "check:paperclip-compat": "tsc -p integrations/paperclip/tsconfig.json",
    "distribute:tokens": "node packages/ui-tokens/distribute.mjs",
    "check": "npm run distribute:tokens && npm run check:architecture && npm run build:boom-frontend && npm run check:paperclip-compat && npm run check --workspaces --if-present",
    "check:architecture": "node scripts/check-architecture-boundaries.mjs",
    "check:any-density": "node scripts/check-any-density.mjs",
    "test:affected": "node scripts/run-affected-tests.mjs",
    "test:contracts": "npm test --workspace=@agent-army/m5-contracts --if-present && npm test --workspace=@agent-army/paperclip-client --if-present",
    "test:core": "npm test --workspace=ajun-runtime",
    "test:m5": "npm test --workspace=@agent-army/m5-content-pipeline && npm test --workspace=@agent-army/paperclip-content-autonomy && npm test --workspace=@agent-army/m5-publisher-gateway",
    "runtime:fingerprint": "node scripts/runtime-fingerprint.mjs",
    "diagnose:feishu-chain": "node apps/ajun-runtime/scripts/diagnose-feishu-commander-chain.mjs",
    "diagnose:hermes-logs": "node apps/ajun-runtime/scripts/attribute-hermes-logs.mjs",
    "stability:baseline": "node scripts/stability-observer.mjs baseline",
    "stability:phase1": "node scripts/run-stability-phase1.mjs",
    "stability:load": "node scripts/stability-observer.mjs load",
    "stability:observe": "node scripts/stability-observer.mjs observe",
    "stability:cost": "node scripts/stability-observer.mjs cost",
    "stability:summarize": "node scripts/stability-observer.mjs summarize",
    "local-ai:status": "ops/local-ai/status.sh",
    "local-ai:smoke": "ops/local-ai/smoke.sh",
    "local-ai:plugin:install": "ops/local-ai/install-plugin.sh",
    "local-ai:plugin:status": "node ops/local-ai/plugin-manager.mjs status"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
