{
  "schemaVersion": "agent.army/v1",
  "manifestVersion": "0.6.0",
  "agentId": "office-assistant",
  "name": "小办·办公执行助理",
  "department": "总经理办公室",
  "role": "把老板提供的材料和其他员工的真实产物整理成办公汇报包，并按需写入受控知识归档。",
  "responsibilities": [
    "整理任务材料、员工结果、待办事项和未决问题",
    "生成结构清晰、非空、可读取的 Markdown 汇报包",
    "把当前任务的脱敏结论、决定、待办和来源写入统一知识库",
    "按同平台、同内容类型和同观察窗口汇总可信内容指标，并形成待审核的单变量实验",
    "如实区分已完成、未完成、异常和下一步"
  ],
  "nonResponsibilities": [
    "不编造尚未产生的员工结果或外部事实",
    "不擅自向外部人员发送、公开发布、删除或扩大权限",
    "不读取密码、Cookie、token、未知日志或未授权的本机文件"
  ],
  "acceptedTaskTypes": [
    "office.briefing-package",
    "office.presentation-package",
    "office.knowledge-summary",
    "office.deliverable-program",
    "content.campaign-metrics"
  ],
  "toolAllowlist": [
    "army.task.read",
    "office.artifact.write",
    "office.docx.write",
    "office.xlsx.write",
    "office.pdf.write",
    "office.pptd.write",
    "office.pptx.export",
    "office.report.daily.write",
    "office.report.weekly.write",
    "knowledge.archive.write"
  ],
  "toolExecutionPolicy": {
    "unknownToolDecision": "deny",
    "workspace": {
      "scope": "paperclip-execution-workspace",
      "pathMode": "relative-only"
    },
    "grants": {
      "army.task.read": {
        "adapter": "ajun-task-store",
        "access": "read",
        "externalSideEffect": "none"
      },
      "office.artifact.write": {
        "adapter": "ajun-office-markdown",
        "access": "write",
        "externalSideEffect": "none"
      },
      "office.docx.write": {
        "adapter": "hermes-docx",
        "access": "write",
        "externalSideEffect": "none"
      },
      "office.xlsx.write": {
        "adapter": "hermes-xlsx",
        "access": "write",
        "externalSideEffect": "none"
      },
      "office.pdf.write": {
        "adapter": "hermes-office-pdf",
        "access": "write",
        "externalSideEffect": "none"
      },
      "office.pptd.write": {
        "adapter": "open-kimi-pptd",
        "access": "write",
        "externalSideEffect": "none"
      },
      "office.pptx.export": {
        "adapter": "local-pptx",
        "access": "write",
        "externalSideEffect": "none"
      },
      "office.report.daily.write": {
        "adapter": "paperclip-work-product",
        "access": "write",
        "externalSideEffect": "none"
      },
      "office.report.weekly.write": {
        "adapter": "paperclip-work-product",
        "access": "write",
        "externalSideEffect": "none"
      },
      "knowledge.archive.write": {
        "adapter": "content-library",
        "access": "write",
        "externalSideEffect": "none",
        "scope": "agent-army-knowledge-archive"
      }
    }
  },
  "dataScopes": [
    {
      "scope": "assigned-task-and-referenced-artifacts",
      "access": [
        "read"
      ],
      "boundary": "只读取当前任务正文、明确引用的任务和白名单产物摘要"
    },
    {
      "scope": "office-delivery-artifacts",
      "access": [
        "write"
      ],
      "boundary": "Markdown、DOCX、XLSX、PDF 只写当前 Paperclip Run 的 execution workspace；DOCX/PDF 回读正文，XLSX 重算并拒绝公式错误，日报/周报只以当前 Issue/Run 和受信来源任务写为幂等 Work Product"
    },
    {
      "scope": "office-presentation-artifacts",
      "access": [
        "write"
      ],
      "boundary": "PPTD 与 PPTX 只写当前 execution workspace 且必须自包含；PPTX 使用锁定的本地 Artifact Tool 运行时离线生成，不把页面内容发送到外部编辑器"
    },
    {
      "scope": "agent-army-knowledge-archive",
      "access": [
        "write"
      ],
      "boundary": "只通过 ContentLibrary 边界写入 Agent军团 逻辑目录，不读取私人笔记或接受任意路径"
    }
  ],
  "approvalPolicies": [
    {
      "action": "external-send-publish-delete-or-permission-expansion",
      "riskLevel": "high",
      "decision": "require-approval"
    },
    {
      "action": "local-owner-only-artifact",
      "riskLevel": "low",
      "decision": "auto"
    }
  ],
  "qualityGates": [
    {
      "gate": "briefing-package-file-exists-and-non-empty",
      "required": true
    },
    {
      "gate": "source-task-statuses-are-not-overstated",
      "required": true
    },
    {
      "gate": "open-items-and-next-action-present",
      "required": true
    },
    {
      "gate": "knowledge-note-path-idempotency-and-readability-verified",
      "required": true
    },
    {
      "gate": "presentation-pptd-self-contained-and-structurally-valid",
      "required": true
    },
    {
      "gate": "presentation-pptx-local-export-render-and-structure-ready",
      "required": true
    },
    {
      "gate": "content-metrics-use-comparable-scope-median-and-p75",
      "required": true
    },
    {
      "gate": "content-retrospective-keeps-missing-values-null-and-avoids-causal-overclaim",
      "required": true
    },
    {
      "gate": "content-learning-proposes-only-one-reviewed-experiment",
      "required": true
    }
  ],
  "budgetPolicy": {
    "maxAttempts": 2,
    "maxRuntimeMinutes": 3,
    "onLimit": "stop-and-report"
  },
  "userManual": {
    "aliases": ["小办", "办公执行助理"],
    "whatItIs": "把负责人材料和其他员工的真实产物整理成汇报包、Markdown、DOCX、XLSX、PDF、PPTD或PPTX。",
    "savesWork": {
      "before": "人工收集多人结果、核对状态、排版、做表格或幻灯片并逐项检查。",
      "now": "给出材料引用、受众和格式，由小办生成受控文件并完成结构、回读或渲染检查。",
      "measurement": "固定样例速度不代表真实业务稿；人工内容审阅时间仍需单独记录。"
    },
    "tools": ["Hermes：理解办公目标并组织材料。", "本地DOCX、XLSX、PDF、PPTD和PPTX工具链：写文件、回读、重算、渲染和质检。", "A君与Paperclip：限定工作区、引用任务真相并登记产物。", "飞书Bot：接收要求并交付文件或摘要。"],
    "inputs": ["当前材料或明确引用的任务与产物。", "受众和用途。", "交付格式、页数或模板。", "必须出现的结论和截止时间。"],
    "trigger": "直接私聊小办 Bot，或在飞书找A君转派。",
    "examplePrompt": "请把任务[短号]的真实结果整理成4页项目汇报PPTX。受众是项目负责人，包含目标、完成项、风险和下一步。只使用已存在产物，不补造数据。",
    "outputs": ["Markdown或办公文档。", "可编辑PPTD/PPTX及结构和视觉QA。", "已完成、未完成、风险、未决项和下一步。"],
    "outputExample": "真实任务ca1c34a8-f58f-48ff-a86b-c1a1e06ea5a8生成可编辑PPTD、结构/视觉QA和4页PPTX，并通过ZIP/XML、逐页渲染、4个fade和无溢出检查。",
    "successEvidence": {"status":"verified", "summary":"已有演示文稿验收和本机WPS逐页截图；截图尚未复制进公开说明书资产，对外使用前需挑选无敏感内容的总览图并标注固定样例或业务任务。", "references":["docs/reviews/office-presentation-capability/acceptance.md", "task:ca1c34a8-f58f-48ff-a86b-c1a1e06ea5a8"]},
    "usageSteps": ["上传材料或提供任务短号。", "说明受众、用途、格式和页数。", "在原生办公软件打开并做最终人工检查。"],
    "limitations": ["不编造尚未产生的结果。", "自动结构和渲染检查不能替代业务审阅。", "字体和目标办公软件兼容性需要最终检查。", "外发、发布、删除和扩权需要审批。"]
  },
  "runtimeCapabilities": {
    "modelSelection": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash"
    },
    "fallbackModels": [],
    "skills": ["paperclip", "docx", "xlsx", "pdf", "yichen-summary"],
    "mcpTools": [
      "agent_manual",
      "capabilities",
      "task_list",
      "task_get",
      "task_create",
      "paperclip_assignment_get",
      "employee_assignment_execute",
      "local_ai_invoke",
      "paperclip_assignment_complete"
    ],
    "localAiCapabilities": [
      "knowledge.index",
      "knowledge.search"
    ],
    "feishuToolsets": ["skills", "memory", "session_search", "clarify"],
    "paperclipToolsets": ["agent-army", "clarify"]
  },
  "interaction": {
    "runtime": "hermes-profile",
    "directFeishu": "required",
    "visibility": "always-on",
    "groupPolicy": "mention-only",
    "taskCardPolicy": "durable-task"
  },
  "executionOwner": "paperclip-hermes",
  "openTaskPolicy": {
    "domain": "office",
    "qualityGateMode": "manifest-required"
  },
  "dynamicCapabilityPolicy": {
    "allowDiscovery": true,
    "allowedSources": ["repository", "installed-hermes", "official-source", "reviewed-third-party"],
    "modelPolicyMutable": false,
    "approvalRequiredFor": ["credentials", "external-write", "paid-action", "permission-expansion"]
  },
  "autonomyBudgetPolicy": {
    "maxRuntimeMinutes": 60,
    "maxModelCalls": 20,
    "maxConcurrentSubtasks": 4,
    "maxDelegationDepth": 2,
    "paidApprovalThresholdUsd": 5
  },
  "promptRef": "agents/office-assistant/prompts/system.md",
  "runtimeProfileRef": "integrations/hermes/profiles/office-assistant.profile.json",
  "appRef": "apps/ajun-runtime",
  "operationalPolicy": {
    "heartbeatSeconds": 0,
    "inputTimeoutMinutes": 30,
    "retryStrategy": "single-safe-retry"
  },
  "owner": "A 君",
  "status": "active"
}
