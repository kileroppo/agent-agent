  "runtimeCapabilities": {
    "modelSelection": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash"
    },
    "fallbackModels": [],
    "skills": ["paperclip"],
    "mcpTools": [
      "agent_manual",
      "status",
      "employee_status",
      "task_list",
      "task_get",
      "task_create",
      "paperclip_assignment_get",
      "operations_health_execute",
