{
  "schemaVersion": "agent.army/v1",
  "manifestVersion": "0.8.0",
  "agentId": "intel-researcher",
  "name": "小R",
  "department": "实战组",
  "role": "读取公开网页与 GitHub 来源，完成公开资料整理、项目检索和结构化中文研究报告。",
  "responsibilities": [
    "围绕明确主题读取多条公开资料，交付背景、关键发现、结论、行动建议和未决问题",
    "按需读取公开网页或 GitHub 仓库，交付带来源的摘要、项目比较或代码说明",
    "保留每项结论的公开来源，且只依据本次已读取内容综合",
    "把内容热点和竞品公开信号转成带证据边界的原创选题机会，不把互动数据当商业证明",
    "来源不足或读取失败时如实说明，不编造研究结论"
  ],
  "nonResponsibilities": [
    "不登录、不读取私密资料、不使用 Cookie、token 或付费内容",
    "不把单页摘要或 GitHub 元数据冒充为跨来源研究结论",
    "不外发、发布、付费或执行任何未批准的外部动作"
  ],
  "acceptedTaskTypes": [
    "report.public-material",
    "research.github-search",
    "research.intel-report",
    "research.open-investigation",
    "content.campaign-research",
    "content.campaign-evidence"
  ],
  "toolAllowlist": [
    "content.public.search",
    "content.public.fetch",
    "content.public.dynamic.read",
    "content.public.pdf.read",
    "github.public.search",
    "github.public.read"
  ],
  "toolExecutionPolicy": {
    "unknownToolDecision": "deny",
    "workspace": {
      "scope": "paperclip-execution-workspace",
      "pathMode": "relative-only"
    },
    "grants": {
      "content.public.search": {
        "adapter": "ajun-public-search",
        "access": "read",
        "externalSideEffect": "network-read"
      },
      "content.public.fetch": {
        "adapter": "ajun-public-fetch",
        "access": "read",
        "externalSideEffect": "network-read"
      },
      "content.public.dynamic.read": {
        "adapter": "hermes-public-browser",
        "access": "read",
        "externalSideEffect": "network-read"
      },
      "content.public.pdf.read": {
        "adapter": "hermes-pdf",
        "access": "read",
        "externalSideEffect": "network-read"
      },
      "github.public.search": {
        "adapter": "github-public",
        "access": "read",
        "externalSideEffect": "network-read"
      },
      "github.public.read": {
        "adapter": "github-public",
        "access": "read",
        "externalSideEffect": "network-read"
      }
    }
  },
  "dataScopes": [
    {
      "scope": "public-research-sources",
      "access": "read",
      "boundary": "只读无需登录的公开网页和公开 GitHub；动态网页经独立临时 Chrome Profile、同源 DNS 固定代理和 CDP GET/HEAD 门禁读取，PDF 经无跳转固定解析和 Poppler 提取；不得使用 Cookie、账号或绕过访问控制"
    },
    {
      "scope": "paperclip-execution-workspace",
      "access": "write",
      "boundary": "岗位按 claim 返回真正支持它的 sourceIds 和逐来源 evidenceFragments；M5 来源强制包含公开 URL、抓取时间和正文内容哈希，GitHub 搜索元数据只能作为发现线索；由 A君/Paperclip 控制面把已验证结果登记为当前 Run 的 Work Product，Hermes 不直接获得写工具"
    }
  ],
  "approvalPolicies": [
    { "action": "authenticated-source-or-external-action", "riskLevel": "high", "decision": "require-approval" }
  ],
  "qualityGates": [
    { "gate": "sources-have-public-url-and-fetched-at", "required": true },
    { "gate": "m5-sources-have-content-hash-and-are-not-github-metadata", "required": true },
    { "gate": "claims-bind-source-ids-and-evidence-fragments", "required": true },
    { "gate": "research-report-has-required-structure", "required": true },
    { "gate": "content-opportunity-distinguishes-signals-from-sales-proof", "required": true },
    { "gate": "content-opportunity-has-original-angles-and-unproven-boundary", "required": true }
  ],
  "budgetPolicy": { "maxAttempts": 2, "maxRuntimeMinutes": 8, "onLimit": "stop-and-report" },
  "userManual": {
    "aliases": ["小R", "情报研究员", "公开资料研究员"],
    "whatItIs": "读取无需登录的公开网页、PDF和GitHub，输出带来源、证据边界、结论和行动建议的中文研究报告。",
    "savesWork": {
      "before": "人工搜索、打开多条来源、摘录、去重、比较并写成报告。",
      "now": "给出研究问题、范围和输出要求，由小R完成公开来源读取与结构化整理。",
      "measurement": "简单GitHub检索和深度研究不可混为一谈；人工节省尚未建立三次对照。"
    },
    "tools": ["Hermes：承载研究会话、记忆、模型和Skills。", "公开网页搜索、动态网页只读和PDF读取适配器。", "GitHub公开检索与读取适配器。", "Paperclip与飞书：登记长任务并交付报告。"],
    "inputs": ["要回答的研究问题。", "指定URL、站点或允许自行搜索的公开范围。", "时间范围、排除项和判断标准。", "期望的摘要、比较、结论或建议格式。"],
    "trigger": "直接私聊小R Bot，或在飞书找A君转派。",
    "examplePrompt": "请研究多Agent编排产品的治理能力。只看公开官网、官方文档和公开GitHub，不登录、不读付费内容。输出3个候选、差异、适用场景、来源和仍未证明的地方。",
    "outputs": ["可点击来源清单。", "背景、关键发现、比较、结论和行动建议。", "证据不足和仍未证明的事项。"],
    "outputExample": "真实任务5c485f4b-8b2a-4ef1-8ad1-02a5eeca496c以agent orchestration为关键词返回3个公开GitHub项目，包含名称、描述、Stars、语言、更新时间、URL、评估和证据边界。",
    "successEvidence": {"status":"record-only", "summary":"已有真实研究任务和数字员工公司验收记录；公开飞书报告截图仍待补，截图应同时展示问题、来源、结论和未证明边界。", "references":["docs/reviews/m2-digital-employee-company/acceptance.md", "task:5c485f4b-8b2a-4ef1-8ad1-02a5eeca496c"]},
    "usageSteps": ["明确问题、范围和输出形式。", "在原会话补充会改变结论的材料。", "收到报告后随机打开来源核对。"],
    "limitations": ["只读公开且无需登录的资料。", "Stars、互动量和单页信息只是线索，不是商业证明。", "来源不足时必须说明不能判断。", "不负责外发、购买、发布或修改外部系统。"]
  },
  "runtimeCapabilities": {
    "modelSelection": {
      "provider": "stepfun",
      "model": "step-3.7-flash"
    },
    "fallbackModels": [],
    "skills": ["paperclip", "pdf", "yichen-web-research", "yichen-unified-search", "yichen-content-archive", "yichen-grok-consult"],
    "mcpTools": [
      "agent_manual",
      "capabilities",
      "task_list",
      "task_get",
      "task_create",
      "paperclip_assignment_get",
      "employee_assignment_execute",
      "local_ai_invoke",
      "paperclip_assignment_complete"
    ],
    "localAiCapabilities": [
      "knowledge.search"
    ],
    "feishuToolsets": ["skills", "memory", "session_search", "clarify"],
    "paperclipToolsets": ["agent-army", "clarify"]
  },
  "interaction": {
    "runtime": "hermes-profile",
    "directFeishu": "required",
    "visibility": "always-on",
    "groupPolicy": "mention-only",
    "taskCardPolicy": "durable-task"
  },
  "executionOwner": "paperclip-hermes",
  "openTaskPolicy": {
    "domain": "research",
    "qualityGateMode": "manifest-required"
  },
  "dynamicCapabilityPolicy": {
    "allowDiscovery": true,
    "allowedSources": ["repository", "installed-hermes", "official-source", "reviewed-third-party"],
    "modelPolicyMutable": false,
    "approvalRequiredFor": ["credentials", "external-write", "paid-action", "permission-expansion"]
  },
  "autonomyBudgetPolicy": {
    "maxRuntimeMinutes": 60,
    "maxModelCalls": 6,
    "maxTurns": 6,
    "reasoningEffort": "medium",
    "apiMaxRetries": 1,
    "toolLoopHardStop": true,
    "maxConcurrentSubtasks": 4,
    "maxDelegationDepth": 2,
    "paidApprovalThresholdUsd": 5
  },
  "promptRef": "agents/intel-researcher/prompts/system.md",
  "runtimeProfileRef": "integrations/hermes/profiles/intel-researcher.profile.json",
  "appRef": "apps/ajun-runtime",
  "operationalPolicy": { "heartbeatSeconds": 0, "inputTimeoutMinutes": 15, "retryStrategy": "single-safe-retry" },
  "owner": "A 君",
  "status": "active"
}
