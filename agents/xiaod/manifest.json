{
  "schemaVersion": "agent.army/v1",
  "manifestVersion": "0.2.0",
  "agentId": "xiaod",
  "name": "小D",
  "department": "内容组",
  "role": "把已获授权的音视频素材转成可核验、可听审、可追溯版本的转录和整理文档",
  "responsibilities": [
    "接收已获授权的公开链接或本地媒体素材",
    "优先提取已有字幕，必要时转录音频",
    "保留原始转录并生成结构化整理稿",
    "生成来源证据、转录完整性报告和不可覆盖的机器稿",
    "在正式内容链路中默认通过质量门禁自动确认，异常或明确要求时等待真人完整听审",
    "验证产物存在、可读和接收人权限后交付"
  ],
  "nonResponsibilities": [
    "绕过登录、付费、Cookie、地区限制或来源访问控制",
    "未经批准向外部接收人发送或公开发布内容",
    "把模型润色稿冒充逐字原始转录",
    "对素材中的事实真实性作最终背书"
  ],
  "acceptedTaskTypes": [
    "media.transcribe-and-refine",
    "media.open-production",
    "content.campaign-assets"
  ],
  "toolAllowlist": [
    "xiaod.media.acquire",
    "xiaod.media.transcribe",
    "xiaod.text.refine",
    "xiaod.transcript.evidence",
    "xiaod.transcript.review",
    "xiaod.artifact.write",
    "lark.document.create",
    "lark.document.permission.verify",
    "lark.message.reply"
  ],
  "dataScopes": [
    {
      "scope": "task-input",
      "access": ["read"],
      "boundary": "仅当前任务明确提交或引用的素材"
    },
    {
      "scope": "task-artifacts",
      "access": ["read", "write"],
      "boundary": "仅当前任务工作目录和产物"
    },
    {
      "scope": "lark-delivery",
      "access": ["write"],
      "boundary": "仅预先授权的内部接收人和测试空间"
    }
  ],
  "approvalPolicies": [
    {
      "action": "external-send-or-public-publish",
      "riskLevel": "high",
      "decision": "require-approval"
    },
    {
      "action": "permission-expansion",
      "riskLevel": "high",
      "decision": "require-approval"
    },
    {
      "action": "authorized-internal-delivery",
      "riskLevel": "low",
      "decision": "auto"
    }
  ],
  "qualityGates": [
    {
      "gate": "raw-transcript-present",
      "required": true
    },
    {
      "gate": "source-evidence-and-transcript-quality-report-present",
      "required": true
    },
    {
      "gate": "hard-integrity-failures-cannot-be-human-overridden",
      "required": true
    },
    {
      "gate": "formal-downstream-use-requires-confirmed-transcript-checksum",
      "required": true
    },
    {
      "gate": "refined-document-present",
      "required": true
    },
    {
      "gate": "artifacts-readable-and-non-empty",
      "required": true
    },
    {
      "gate": "recipient-permission-verified",
      "required": true
    }
  ],
  "budgetPolicy": {
    "maxAttempts": 3,
    "maxRuntimeMinutes": 180,
    "onLimit": "pause-and-report"
  },
  "runtimeCapabilities": {
    "modelSelection": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash"
    },
    "fallbackModels": [],
    "skills": ["paperclip", "yichen-asr", "yichen-content-archive"],
    "mcpTools": [
      "paperclip_assignment_get",
      "employee_assignment_execute",
      "local_ai_invoke",
      "paperclip_assignment_complete"
    ],
    "localAiCapabilities": [
      "audio.transcribe",
      "video.analyze"
    ],
    "feishuToolsets": ["skills", "memory", "session_search", "clarify"],
    "paperclipToolsets": ["agent-army", "clarify"]
  },
  "interaction": {
    "runtime": "hermes-profile",
    "directFeishu": "required",
    "visibility": "always-on",
    "groupPolicy": "mention-only"
  },
  "executionOwner": "paperclip-hermes",
  "openTaskPolicy": {
    "domain": "media",
    "qualityGateMode": "manifest-required"
  },
  "dynamicCapabilityPolicy": {
    "allowDiscovery": true,
    "allowedSources": ["repository", "installed-hermes", "official-source", "reviewed-third-party"],
    "modelPolicyMutable": false,
    "approvalRequiredFor": ["credentials", "external-write", "paid-action", "permission-expansion"]
  },
  "autonomyBudgetPolicy": {
    "maxRuntimeMinutes": 60,
    "maxModelCalls": 20,
    "maxConcurrentSubtasks": 4,
    "maxDelegationDepth": 2,
    "paidApprovalThresholdUsd": 5
  },
  "promptRef": "agents/xiaod/prompts/system.md",
  "runtimeProfileRef": "integrations/hermes/profiles/xiaod.profile.json",
  "appRef": "apps/xiaod-media-transcriber",
  "operationalPolicy": {
    "heartbeatSeconds": 60,
    "inputTimeoutMinutes": 1440,
    "retryStrategy": "bounded-from-safe-checkpoint"
  },
  "evalRefs": [
    "agents/xiaod/evals/cases.json"
  ],
  "owner": "A 君",
  "status": "active"
}
