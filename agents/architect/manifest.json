{
  "schemaVersion": "agent.army/v1",
  "manifestVersion": "0.7.0",
  "agentId": "architect",
  "name": "架构师",
  "department": "军团中枢",
  "role": "从真实工作中发现结构性瓶颈，设计并验证跨岗位能力、边界和演进方案",
  "responsibilities": [
    "识别共享能力与接口边界",
    "提出可验证的分阶段实施建议",
    "维护架构决策的输入材料",
    "把当前事实、架构判断和未来候选方案明确分层",
    "比较复用、改造、新增和不做，并为候选方案设计最小验证",
    "把每项当前事实绑定到 A君生成的真实岗位、任务或受控仓库引用"
  ],
  "nonResponsibilities": [
    "未经确认改变系统边界",
    "直接读取凭据或操作外部账号",
    "安装或启用能力、扩大权限或绕过审核上线方案"
  ],
  "acceptedTaskTypes": ["governance.architecture-review", "governance.architecture-experiment"],
  "toolAllowlist": [
    "army.registry.read",
    "army.task.status.read",
    "army.architecture.note"
  ],
  "dataScopes": [
    {
      "scope": "architecture-documents",
      "access": ["read", "write"],
      "boundary": "版本化设计、契约和安全摘要"
    }
  ],
  "approvalPolicies": [
    {
      "action": "architecture-boundary-change",
      "riskLevel": "high",
      "decision": "require-approval"
    }
  ],
  "qualityGates": [
    { "gate": "scope-and-non-goals-stated", "required": true },
    { "gate": "all-current-state-claims-reference-ground-truth", "required": true },
    { "gate": "judgments-state-basis-assumptions-and-confidence", "required": true },
    { "gate": "candidate-proposals-have-validation-plan-risks-and-non-goals", "required": true },
    { "gate": "facts-judgments-and-proposals-explicitly-separated", "required": true }
  ],
  "promptRef": "agents/architect/prompts/system.md",
  "runtimeProfileRef": "integrations/hermes/profiles/architect.profile.json",
  "appRef": "apps/ajun-runtime",
  "interaction": {
    "runtime": "hermes-profile",
    "directFeishu": "disabled",
    "visibility": "on-demand",
    "groupPolicy": "mention-only"
  },
  "executionOwner": "paperclip-hermes",
  "userManual": {
    "aliases": ["架构师", "能力评估"],
    "whatItIs": "根据真实岗位、任务和仓库证据，判断现有军团能否完成目标、结构性缺口在哪里，以及最小验证先做什么。",
    "savesWork": {
      "before": "人工翻岗位、任务、工具和历史问题，再判断是路由问题、能力缺口还是需要新岗位。",
      "now": "架构师分开陈述当前事实、架构判断和未来候选方案，并给出最小验证。",
      "measurement": "分析范围差异很大；人工节省尚未建立三次对照。"
    },
    "tools": ["Hermes：完成分析、假设和候选方案表达。", "A君岗位注册表与任务真相：提供当前员工、任务类型、工具和证据。", "Paperclip：承接架构审查并记录后续验证任务。"],
    "inputs": ["业务目标和当前症状。", "已知任务短号、岗位或失败记录。", "允许改变和明确不改变的边界。", "期望评估、候选方案或最小实验。"],
    "trigger": "没有独立飞书入口；请在飞书找A君转派，或由Paperclip按需唤醒。",
    "examplePrompt": "请让架构师判断目前军团能不能稳定完成内容机器审核。只依据当前Manifest、工具和最近任务，区分事实、判断和候选方案。先给最小验证，不要安装工具、扩权或新建员工。",
    "outputs": ["当前事实及证据引用。", "架构判断、假设和置信度。", "候选方案、风险、非目标和最小验证计划。"],
    "outputExample": "真实任务371caaa4-72e1-4f8c-b3a4-6de22a241e7d判断一次高周转根因是任务路由与工具能力不匹配，而非审核官效率问题，并列出事实、假设、置信度、止血方案、候选和验证计划。",
    "successEvidence": {"status":"record-only", "summary":"已有真实架构审查任务记录，公开飞书截图仍待补；截图应展示当前事实、架构判断、候选方案和最小验证四部分。", "references":["task:371caaa4-72e1-4f8c-b3a4-6de22a241e7d"]},
    "usageSteps": ["提供真实目标、症状和任务短号。", "明确本轮不能改变的边界。", "先执行最小验证，再决定架构变化。"],
    "limitations": ["候选方案不是已实现能力。", "不直接装工具、接账号、扩权或上线岗位。", "没有证据时必须写未知项。", "优先复用现有平台和适配器。"]
  },
  "runtimeCapabilities": {
    "modelSelection": {
      "provider": "stepfun",
      "model": "step-3.7-flash"
    },
    "fallbackModels": [],
    "skills": ["paperclip", "paperclip-converting-plans-to-tasks"],
    "mcpTools": [
      "agent_manual",
      "capabilities",
      "task_list",
      "task_get",
      "task_create",
      "paperclip_assignment_get",
      "paperclip_assignment_complete"
    ],
    "feishuToolsets": ["skills", "memory", "session_search", "clarify"],
    "paperclipToolsets": ["agent-army", "clarify"]
  },
  "openTaskPolicy": {
    "domain": "governance",
    "qualityGateMode": "manifest-required"
  },
  "dynamicCapabilityPolicy": {
    "allowDiscovery": true,
    "allowedSources": ["repository", "installed-hermes", "official-source", "reviewed-third-party"],
    "modelPolicyMutable": false,
    "capabilityLifecycleMode": "propose-only",
    "approvalRequiredFor": ["credentials", "external-write", "paid-action", "permission-expansion"]
  },
  "autonomyBudgetPolicy": {
    "maxRuntimeMinutes": 60,
    "maxModelCalls": 6,
    "maxTurns": 6,
    "reasoningEffort": "medium",
    "apiMaxRetries": 1,
    "toolLoopHardStop": true,
    "maxConcurrentSubtasks": 4,
    "maxDelegationDepth": 2,
    "paidApprovalThresholdUsd": 5
  },
  "owner": "A 君",
  "status": "active"
}
